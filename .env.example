# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (then redeploy).

# Backend API base URL (the certifications_server deployment) — must end in /api/v1
# Local:      http://localhost:5000/api/v1
# Production: https://<server-project>.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Reown (WalletConnect) project id — create one at https://dashboard.reown.com
# and add the app's domain under the project's allowed domains.
NEXT_PUBLIC_PROJECT_ID=
